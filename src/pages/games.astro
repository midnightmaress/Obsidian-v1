---
import Layout from "../Layouts/Layout.astro";
---

<Layout title="Obsidian Games">
	<main class="app-shell" id="games-app">
		<header class="app-header">
			<a class="app-brand" href="/">
				<img src="/img/obsidian.svg" alt="" />
				<h1>Games</h1>
			</a>
			<div class="app-actions">
				<a class="icon-button" href="/" aria-label="Home" title="Home">
					<svg viewBox="0 0 24 24" width="19" height="19" fill="none" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1V10Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
				</a>
			</div>
		</header>
		<div class="games-tools">
			<input id="games-search" class="field" type="search" placeholder="Search games" aria-label="Search games" autocomplete="off" />
			<select id="games-source" class="select-field" aria-label="Game source">
				<option value="all">All sources</option>
				<option value="noahs">Noah's Calculus Tutor</option>
				<option value="ugs">UGS Files Sorted</option>
			</select>
		</div>
		<p id="games-status" class="status-message" role="status" aria-live="polite">Loading game catalog...</p>
		<div id="games-grid" aria-live="polite"></div>
	</main>
	<script src="../scripts/games.ts"></script>
</Layout>

<style is:global>
	#games-source {
		max-width: 230px;
	}

	@media (max-width: 650px) {
		.games-tools {
			flex-direction: column;
			align-items: stretch;
		}
		#games-source {
			max-width: none;
		}
	}
</style>