---
import Layout from "../Layouts/Layout.astro";
---

<Layout title="Obsidian Settings">
	<main class="app-shell settings-app">
		<header class="app-header">
			<a class="app-brand" href="/">
				<img src="/img/obsidian.svg" alt="" />
				<h1>Settings</h1>
			</a>
			<a class="icon-button" href="/" aria-label="Home" title="Home">
				<svg viewBox="0 0 24 24" width="19" height="19" fill="none" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1V10Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
			</a>
		</header>
		<section class="settings-content" aria-labelledby="appearance-heading">
			<p class="eyebrow">PERSONALIZE YOUR SPACE</p>
			<h2 class="page-heading" id="appearance-heading">Appearance</h2>
			<p class="status-message">Choose a glass palette for the whole workspace.</p>
			<fieldset class="theme-picker">
				<legend class="sr-only">Color theme</legend>
				<label class="theme-choice">
					<input type="radio" name="theme" value="midnight" />
					<span class="theme-swatch" data-swatch="midnight" aria-hidden="true"></span>
					<span class="theme-copy"><strong>Midnight</strong><small>Deep charcoal · mint glass</small></span>
					<span class="theme-check" aria-hidden="true">✓</span>
				</label>
				<label class="theme-choice">
					<input type="radio" name="theme" value="frost" />
					<span class="theme-swatch" data-swatch="frost" aria-hidden="true"></span>
					<span class="theme-copy"><strong>Frost</strong><small>Soft silver · bright blue</small></span>
					<span class="theme-check" aria-hidden="true">✓</span>
				</label>
				<label class="theme-choice">
					<input type="radio" name="theme" value="ocean" />
					<span class="theme-swatch" data-swatch="ocean" aria-hidden="true"></span>
					<span class="theme-copy"><strong>Ocean</strong><small>Deep water · clear cyan</small></span>
					<span class="theme-check" aria-hidden="true">✓</span>
				</label>
				<label class="theme-choice">
					<input type="radio" name="theme" value="sunset" />
					<span class="theme-swatch" data-swatch="sunset" aria-hidden="true"></span>
					<span class="theme-copy"><strong>Sunset</strong><small>Smoked plum · warm coral</small></span>
					<span class="theme-check" aria-hidden="true">✓</span>
				</label>
			</fieldset>
			<p id="theme-status" class="status-message" role="status" aria-live="polite"></p>
		</section>
	</main>
	<script src="../scripts/settings.ts"></script>
</Layout>