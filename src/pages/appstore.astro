---
import Layout from "../Layouts/Layout.astro";
---

<Layout title="Obsidian Apps">
	<main class="app-shell" id="apps-app">
		<header class="app-header">
			<a class="app-brand" href="/">
				<img src="/img/obsidian.svg" alt="" />
				<h1>Apps</h1>
			</a>
			<a class="icon-button" href="/" aria-label="Home" title="Home">
				<svg viewBox="0 0 24 24" width="19" height="19" fill="none" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1V10Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
			</a>
		</header>
		<h2 class="page-heading">Launcher</h2>
		<nav class="apps-grid" id="apps-grid" aria-label="Apps"></nav>
		<hr class="section-rule" />
		<h2 class="page-heading">Add a link</h2>
		<form id="custom-app-form" class="games-tools">
			<input class="field" id="custom-app-name" type="text" placeholder="Name" aria-label="App name" required maxlength="60" />
			<input class="field" id="custom-app-url" type="url" placeholder="https://example.com" aria-label="App URL" required />
			<button class="primary-button" type="submit">Add</button>
		</form>
		<p id="apps-status" class="status-message" role="status" aria-live="polite"></p>
	</main>
	<script src="../scripts/appsApp.ts"></script>
</Layout>