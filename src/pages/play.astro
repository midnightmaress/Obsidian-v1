---
import Layout from "../Layouts/Layout.astro";
---

<Layout title="Obsidian Game" proxy={true}>
	<main id="game-player">
		<header class="app-header">
			<a class="quiet-button" id="back-btn" href="/games">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
				Games
			</a>
			<div class="app-brand">
				<img id="game-icon" src="/img/obsidian.svg" alt="" />
				<h1 id="game-title">Loading game...</h1>
			</div>
			<div class="app-actions">
				<button class="icon-button" id="reload-btnp" type="button" aria-label="Reload game" title="Reload game">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5m-4.1-2a7 7 0 0 1 11.6-3L20 12M4 12l3.5 5a7 7 0 0 0 11.6-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</button>
				<button class="icon-button" id="fullscreen-btn" type="button" aria-label="Enter fullscreen" aria-pressed="false" title="Fullscreen">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m13-5h3a2 2 0 0 1 2 2v3M3 16v3a2 2 0 0 0 2 2h3m13-5v3a2 2 0 0 1-2 2h-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
				</button>
			</div>
		</header>
		<div id="game-container">
			<iframe id="game-frame" src="" title="Selected game" allow="autoplay; fullscreen; gamepad; pointer-lock" referrerpolicy="no-referrer"></iframe>
		</div>
		<p id="game-status" class="status-message" role="status" aria-live="polite"></p>
	</main>
	<script src="../scripts/play.ts"></script>
</Layout>

<style is:global>
	#game-player > .app-header {
		padding: 0 0 12px;
		border: 0;
	}

	#game-container {
		min-height: 0;
		border: 1px solid var(--obsidian-border);
		border-radius: 8px;
		overflow: hidden;
	}

	#game-container:fullscreen {
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: #000;
	}

	#game-frame {
		width: 100%;
		height: 100%;
		border: 0;
		background: #000;
	}

	#game-container:fullscreen #game-frame {
		width: 100vw;
		height: 100vh;
		height: 100dvh;
	}
</style>