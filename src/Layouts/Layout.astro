---
import "../styles/global.css";
import ParticleField from "../components/particleField.astro";

export interface Props {
	title: string;
	proxy?: boolean;
	particles?: boolean;
}

const { title, proxy = false, particles = true } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/img/obsidian.svg" />
		<meta name="theme-color" content="#050605" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{proxy && (
			<>
				<script is:inline src="/baremux/index.js" />
				<script is:inline src="/learn/scramjet.all.js" />
				<script src="../scripts/proxy.ts" />
			</>
		)}
	</head>
	<body>
		{particles && <ParticleField />}
		<slot />
	</body>
</html>